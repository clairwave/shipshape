{
  "1": {"class_type": "LoadImage", "_meta": {"title": "ShipImage"}, "inputs": {
    "image": "ship.png"}},
  "2": {"class_type": "Hy3D_2_1SimpleMeshGen", "_meta": {"title": "Sampler"}, "inputs": {
    "model": "hunyuan3d-dit-v2-1.fp16.ckpt", "image": ["1", 0],
    "steps": 50, "guidance_scale": 5.0, "octree_resolution": 384}},
  "3": {"class_type": "Hy3DPostprocessMesh", "_meta": {"title": "Post"}, "inputs": {
    "trimesh": ["2", 0], "remove_floaters": true,
    "remove_degenerate_faces": true, "reduce_faces": true,
    "max_facenum": 40000, "smooth_normals": false}},
  "4": {"class_type": "Hy3DMeshUVWrap", "_meta": {"title": "UVWrap"}, "inputs": {
    "trimesh": ["3", 0]}},
  "5": {"class_type": "Hy3DCameraConfig", "_meta": {"title": "Cameras"}, "inputs": {
    "camera_azimuths": "0, 90, 180, 270, 0, 180",
    "camera_elevations": "0, 0, 0, 0, 90, -90",
    "view_weights": "1, 0.1, 0.5, 0.1, 0.05, 0.05",
    "camera_distance": 1.45, "ortho_scale": 1.2}},
  "6": {"class_type": "Hy3DRenderMultiView", "_meta": {"title": "Render"}, "inputs": {
    "trimesh": ["4", 0], "render_size": 1024, "texture_size": 1024,
    "camera_config": ["5", 0], "normal_space": "world"}},
  "7": {"class_type": "DownloadAndLoadHy3DDelightModel", "_meta": {"title": "DelightModel"}, "inputs": {
    "model": "hunyuan3d-delight-v2-0"}},
  "8": {"class_type": "Hy3DDelightImage", "_meta": {"title": "Delight"}, "inputs": {
    "delight_pipe": ["7", 0], "image": ["1", 0],
    "steps": 50, "width": 512, "height": 512, "cfg_image": 1.0, "seed": 42}},
  "9": {"class_type": "DownloadAndLoadHy3DPaintModel", "_meta": {"title": "PaintModel"}, "inputs": {
    "model": "hunyuan3d-paint-v2-0"}},
  "10": {"class_type": "Hy3DSampleMultiView", "_meta": {"title": "Multiview"}, "inputs": {
    "pipeline": ["9", 0], "ref_image": ["8", 0],
    "normal_maps": ["6", 0], "position_maps": ["6", 1],
    "view_size": 512, "steps": 30, "seed": 42,
    "camera_config": ["5", 0], "denoise_strength": 1.0}},
  "11": {"class_type": "Hy3DBakeFromMultiview", "_meta": {"title": "Bake"}, "inputs": {
    "images": ["10", 0], "renderer": ["6", 2], "camera_config": ["5", 0]}},
  "12": {"class_type": "Hy3DMeshVerticeInpaintTexture", "_meta": {"title": "Inpaint"}, "inputs": {
    "texture": ["11", 0], "mask": ["11", 1], "renderer": ["11", 2]}},
  "13": {"class_type": "Hy3DApplyTexture", "_meta": {"title": "ApplyTex"}, "inputs": {
    "texture": ["12", 0], "renderer": ["12", 2]}},
  "14": {"class_type": "Hy3DExportMesh", "_meta": {"title": "Save"}, "inputs": {
    "trimesh": ["13", 0], "filename_prefix": "3D/ship_prod", "file_format": "glb",
    "save_file": true}}
}
