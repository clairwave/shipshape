{
  "1": {"class_type": "Hy3DModelLoader", "_meta": {"title": "Loader"}, "inputs": {
    "model": "hunyuan3d-dit-v2-0-fp16.safetensors",
    "attention_mode": "sdpa", "cublas_ops": false}},
  "2": {"class_type": "LoadImage", "_meta": {"title": "ShipImage"}, "inputs": {
    "image": "ship.png"}},
  "3": {"class_type": "Hy3DGenerateMesh", "_meta": {"title": "Sampler"}, "inputs": {
    "pipeline": ["1", 0], "image": ["2", 0],
    "guidance_scale": 5.5, "steps": 30, "seed": 42,
    "scheduler": "FlowMatchEulerDiscreteScheduler", "force_offload": true}},
  "4": {"class_type": "Hy3DVAEDecode", "_meta": {"title": "Decode"}, "inputs": {
    "vae": ["1", 1], "latents": ["3", 0],
    "box_v": 1.01, "octree_resolution": 384, "num_chunks": 8000,
    "mc_level": 0, "mc_algo": "mc",
    "enable_flash_vdm": true, "force_offload": true}},
  "5": {"class_type": "Hy3DPostprocessMesh", "_meta": {"title": "Post"}, "inputs": {
    "trimesh": ["4", 0], "remove_floaters": true,
    "remove_degenerate_faces": true, "reduce_faces": true,
    "max_facenum": 40000, "smooth_normals": false}},
  "6": {"class_type": "Hy3DMeshUVWrap", "_meta": {"title": "UVWrap"}, "inputs": {
    "trimesh": ["5", 0]}},
  "7": {"class_type": "Hy3DCameraConfig", "_meta": {"title": "Cameras"}, "inputs": {
    "camera_azimuths": "0, 90, 180, 270, 0, 180",
    "camera_elevations": "0, 0, 0, 0, 90, -90",
    "view_weights": "1, 0.1, 0.5, 0.1, 0.05, 0.05",
    "camera_distance": 1.45, "ortho_scale": 1.2}},
  "8": {"class_type": "Hy3DRenderMultiView", "_meta": {"title": "Render"}, "inputs": {
    "trimesh": ["6", 0], "render_size": 1024, "texture_size": 1024,
    "camera_config": ["7", 0], "normal_space": "world"}},
  "9": {"class_type": "DownloadAndLoadHy3DDelightModel", "_meta": {"title": "DelightModel"}, "inputs": {
    "model": "hunyuan3d-delight-v2-0"}},
  "10": {"class_type": "Hy3DDelightImage", "_meta": {"title": "Delight"}, "inputs": {
    "delight_pipe": ["9", 0], "image": ["2", 0],
    "steps": 50, "width": 512, "height": 512, "cfg_image": 1.0, "seed": 42}},
  "11": {"class_type": "DownloadAndLoadHy3DPaintModel", "_meta": {"title": "PaintModel"}, "inputs": {
    "model": "hunyuan3d-paint-v2-0"}},
  "12": {"class_type": "Hy3DSampleMultiView", "_meta": {"title": "Multiview"}, "inputs": {
    "pipeline": ["11", 0], "ref_image": ["10", 0],
    "normal_maps": ["8", 0], "position_maps": ["8", 1],
    "view_size": 512, "steps": 30, "seed": 42,
    "camera_config": ["7", 0], "denoise_strength": 1.0}},
  "13": {"class_type": "Hy3DBakeFromMultiview", "_meta": {"title": "Bake"}, "inputs": {
    "images": ["12", 0], "renderer": ["8", 2], "camera_config": ["7", 0]}},
  "14": {"class_type": "Hy3DMeshVerticeInpaintTexture", "_meta": {"title": "Inpaint"}, "inputs": {
    "texture": ["13", 0], "mask": ["13", 1], "renderer": ["13", 2]}},
  "15": {"class_type": "Hy3DApplyTexture", "_meta": {"title": "ApplyTex"}, "inputs": {
    "texture": ["14", 0], "renderer": ["14", 2]}},
  "16": {"class_type": "Hy3DExportMesh", "_meta": {"title": "Save"}, "inputs": {
    "trimesh": ["15", 0], "filename_prefix": "3D/ship_tex", "file_format": "glb",
    "save_file": true}}
}
