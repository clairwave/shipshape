{
  "1": {"class_type": "Hy3DModelLoader", "_meta": {"title": "Loader"}, "inputs": {
    "model": "hunyuan3d-dit-v2-0-fp16.safetensors",
    "attention_mode": "sdpa", "cublas_ops": false}},
  "2": {"class_type": "LoadImage", "_meta": {"title": "ShipImage"}, "inputs": {
    "image": "ship.png"}},
  "3": {"class_type": "Hy3DGenerateMesh", "_meta": {"title": "Sampler"}, "inputs": {
    "pipeline": ["1", 0], "image": ["2", 0],
    "guidance_scale": 5.5, "steps": 30, "seed": 42,
    "scheduler": "FlowMatchEulerDiscreteScheduler", "force_offload": true}},
  "4": {"class_type": "Hy3DVAEDecode", "_meta": {"title": "Decode"}, "inputs": {
    "vae": ["1", 1], "latents": ["3", 0],
    "box_v": 1.01, "octree_resolution": 384, "num_chunks": 8000,
    "mc_level": 0, "mc_algo": "mc",
    "enable_flash_vdm": true, "force_offload": true}},
  "5": {"class_type": "Hy3DPostprocessMesh", "_meta": {"title": "Post"}, "inputs": {
    "trimesh": ["4", 0], "remove_floaters": true,
    "remove_degenerate_faces": true, "reduce_faces": true,
    "max_facenum": 40000, "smooth_normals": false}},
  "6": {"class_type": "Hy3DExportMesh", "_meta": {"title": "Save"}, "inputs": {
    "trimesh": ["5", 0], "filename_prefix": "3D/ship", "file_format": "glb",
    "save_file": true}}
}
