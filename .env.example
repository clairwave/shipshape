# ship3d configuration — all values have working defaults for the reference
# deployment; override for your own infrastructure.

# ComfyUI endpoint running the Hunyuan3D wrapper (generation node)
COMFYUI_URL=http://127.0.0.1:8189

# Fleet model store root (qc-api, stage_worker; on the storage host)
SHIP3D_STORE=/data/ships

# ssh target the workers push results to (host that owns SHIP3D_STORE)
SHIP3D_SSH_REMOTE=user@storage-host

# Path to a BasisU-enabled gltfpack binary (native build, not the npm one)
#GLTFPACK=/usr/local/bin/gltfpack

# Secrets (files, not env):
#   secrets/qc_token — shared token for qc-api mutating endpoints
#     (same value deployed next to qc_api.py as 'token')
